@model IEnumerable<EczaneOtomasyonu.Models.Hastalar>

@{
    ViewData["Title"] = "Index";
}

<h1>👥 Hasta Kayıt Rehberi</h1>

<p>
   <a href="/Admin/Hastalars/Create" class="btn btn-success mb-3 shadow-sm">
    ➕ Yeni Hasta Kaydı Oluştur
</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>T.C. Kimlik No</th>
            <th>Ad Soyad</th>
            <th>Telefon</th>
            <th>E-Posta</th>
            <th>Adres</th>
            <th>Doğum Tarihi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
   
        <tbody>
               <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Tc</td>
            
            <td>@item.Ad @item.Soyad</td>
            
            <td>@item.Telefon</td>
            
            <td>-</td>
            
            <td>-</td>
            
            <td>@item.KayitTarihi</td>
            
            <td class="text-center">
                <a href="/Admin/Hastalars/Edit/@item.HastaId" class="btn btn-primary btn-sm mx-1 text-white">Düzenle</a>
                <a href="/Admin/Hastalars/Details/@item.HastaId" class="btn btn-info btn-sm mx-1 text-white">Detay</a>
                <a href="/Admin/Hastalars/Delete/@item.HastaId" class="btn btn-danger btn-sm mx-1 text-white">Sil</a>
            </td>
        </tr>
    }
</tbody>
        </tbody>
    </tbody>
</table
