@model IEnumerable<EczaneOtomasyonu.Models.Kategoriler>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>📂 İlaç Kategorileri</h1>
    <a asp-action="Create" class="btn btn-success">➕ Yeni Kategori Ekle</a>
</div>

<table class="table table-hover shadow-sm border">
    <thead class="table-dark">
        <tr>
            <th>Kategori Adı</th>
            <th class="text-center">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="fw-bold">
                    @item.KategoriAdi
                <td class="text-center">
                    <a href="/Admin/Kategoriler/Edit/@item.KategoriId" class="btn btn-primary btn-sm mx-1 text-white">Düzenle</a>
                    <a href="/Admin/Kategoriler/Details/@item.KategoriId" class="btn btn-info btn-sm mx-1 text-white">Detay</a>
                    <a href="/Admin/Kategoriler/Delete/@item.KategoriId" class="btn btn-danger btn-sm mx-1 text-white">Sil</a>
                </td>
                </td>
            </tr>
        }
    </tbody>
</table>
