@model IEnumerable<EczaneOtomasyonu.Models.Sepet>

@{
    ViewData["Title"] = "Sepetim";
}

<div class="container mt-5 mb-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-success text-white text-center py-3">
            <h3 class="mb-0 fw-bold">🛒 Sepetim</h3>
        </div>
        <div class="card-body p-4 bg-light">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover bg-white rounded-3 shadow-sm text-center align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>İlaç Adı</th>
                            <th>Birim Fiyat</th>
                            <th>Adet</th>
                            <th>Toplam</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.Ilac.IlacAdi</td>
                                <td>@item.Ilac.BirimFiyat.ToString("C2")</td>
                                <td><span class="badge bg-secondary fs-6">@item.Adet</span></td>
                                <td class="text-success fw-bold">@((item.Ilac.BirimFiyat * item.Adet).ToString("C2"))</td>
                                <td class="text-center">
                                    <a href="/Sepet/Sil/@item.SepetId" class="btn btn-danger btn-sm shadow-sm fw-bold">
                                         Çıkar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="text-end mt-4">
                    <button class="btn btn-success btn-lg fw-bold shadow">✅ Reçeteyi Onayla ve Satın Al</button>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center" role="alert">
                    <h5 class="mb-0">Sepetinizde henüz ilaç bulunmamaktadır.</h5>
                </div>
            }
        </div>
    </div>
</div>