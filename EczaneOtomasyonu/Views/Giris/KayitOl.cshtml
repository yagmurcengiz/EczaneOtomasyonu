@model EczaneOtomasyonu.Models.Kullanici
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yağmur Eczanesi - Kayıt Ol</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-dark d-flex align-items-center" style="height: 100vh;">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-4">
                <div class="card shadow-lg border-0 rounded-3">
                    <div class="card-header bg-success text-white text-center py-4 rounded-top-3">
                        <h3 class="fw-bold mb-0">📝 Yeni Hesap Oluştur</h3>
                        <small class="text-white-50">Yağmur Eczanesi ailemize katılın</small>
                    </div>
                    <div class="card-body p-4">

                        @if (ViewBag.Hata != null)
                        {
                            <div class="alert alert-danger text-center py-2">@ViewBag.Hata</div>
                        }

                        <form method="post" action="/Giris/KayitOl">
                            <div class="form-floating mb-3">
                                <input class="form-control" asp-for="KullaniciAdi" type="text" placeholder="Kullanıcı Adı" required />
                                <label>Kullanıcı Adı</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input class="form-control" asp-for="Sifre" type="password" placeholder="Şifre" required />
                                <label>Şifre</label>
                            </div>

                            <button class="btn btn-success w-100 py-2.5 fs-5 fw-bold mt-3 shadow-sm" type="submit">Kayıt Ol ve Tamamla</button>
                        </form>

                        <div class="text-center mt-3">
                            <a href="/Giris/Index" class="text-decoration-none small text-muted">Zaten hesabınız var mı? Giriş Yapın</a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>