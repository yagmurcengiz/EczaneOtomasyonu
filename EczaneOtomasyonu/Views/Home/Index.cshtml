@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container mt-5">
    <div class="row align-items-center bg-light rounded-4 shadow-sm p-5 mb-5 border-0">
        <div class="col-lg-7 text-center text-lg-start">
            <h1 <h1 class="text-primary fw-bold"> Dijital Eczane Sistemimize Hoş Geldiniz</h1>
<p class="lead text-secondary">Güvenilir altyapımız, anlık stok takibi ve hızlı reçete yönetimimiz ile sağlığınız güvence altında.</p>
            @if (!User.Identity.IsAuthenticated)
            {
                <a asp-controller="Giris" asp-action="Index" class="btn btn-primary btn-lg px-4 me-md-2 fw-bold shadow-sm">Sisteme Giriş Yap</a>
            }
            else
            {
                <div class="alert alert-success d-inline-block shadow-sm">
                    <strong>Hoş geldiniz, @User.Identity.Name!</strong> Sol üstteki menüden işlemlere devam edebilirsiniz.
                </div>
            }
        </div>
        <div class="col-lg-5 d-none d-lg-block text-center">
            <span style="font-size: 12rem;">🏥</span>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-primary border-4 py-3">
                <div class="card-body text-center">
                    <h1 class="display-5 mb-3">📦</h1>
                    <h5 class="card-title fw-bold">Geniş İlaç Ağı</h5>
                    <p class="card-text text-muted">Eczanemizdeki tüm güncel ilaç stoklarını ve fiyatlarını anlık olarak sistemden takip edebilirsiniz.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-success border-4 py-3">
                <div class="card-body text-center">
                    <h1 class="display-5 mb-3">🛡️</h1>
                    <h5 class="card-title fw-bold">Güvenli Altyapı</h5>
                    <p class="card-text text-muted">Yetkilendirilmiş personel ve müşteri erişimleri sayesinde verileriniz her zaman güvende.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-info border-4 py-3">
                <div class="card-body text-center">
                    <h1 class="display-5 mb-3">👥</h1>
                    <h5 class="card-title fw-bold">Hasta Takibi</h5>
                    <p class="card-text text-muted">Reçete ve hasta kayıtlarını düzenli bir şekilde tutarak hizmet kalitesini en üst düzeye çıkarın.</p>
                </div>
            </div>
        </div>
    </div>
</div>